{
  "id": "/HTMLMemo/",
  "name": "LibreMemo · 나만의 웹 서재",
  "short_name": "LibreMemo",
  "description": "웹 페이지 저장과 주석을 한 HTML 파일 안에",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7fb",
  "theme_color": "#334155",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "multipart/related": [
          ".mhtml",
          ".mht"
        ],
        "application/x-mimearchive": [
          ".mhtml",
          ".mht"
        ],
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
