{
  "name": "htmlmemo",
  "version": "1.2.10",
  "private": true,
  "type": "module",
  "description": "웹 페이지를 한 파일로 보관하고 주석을 자동 저장하는 PWA",
  "repository": {
    "type": "git",
    "url": "https://github.com/seionwon/HTMLMemo.git"
  },
  "homepage": "https://seionwon.github.io/HTMLMemo/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/open.mjs",
    "start": "node scripts/open.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node --test tests/browser.integration.mjs"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3"
  }
}
