{
  "manifest_version": 3,
  "name": "LibreMemo · Chrome 연결",
  "version": "1.2.0",
  "description": "실제 Chrome 탭을 HTML 한 파일로 저장하고 LibreMemo 주석 탭에서 엽니다.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "LibreMemo에 페이지 저장" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://seionwon.github.io/LibreMemo/*", "https://seionwon.github.io/HTMLMemo/*", "http://localhost/*", "http://127.0.0.1/*", "file:///*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
